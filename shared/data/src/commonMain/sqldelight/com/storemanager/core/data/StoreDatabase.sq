CREATE UNIQUE INDEX ux_one_base_currency ON currencies(is_base) WHERE is_base=1;

CREATE UNIQUE INDEX ux_product_barcode ON products(barcode) WHERE barcode IS NOT NULL AND barcode<>'';

CREATE UNIQUE INDEX ux_variant_barcode ON product_variants(barcode) WHERE barcode IS NOT NULL AND barcode<>'';

