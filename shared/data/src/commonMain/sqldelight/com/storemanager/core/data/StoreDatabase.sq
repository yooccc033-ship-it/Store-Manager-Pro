-- ====================================================================
-- Baseline Queries
-- ====================================================================

selectAllTenants:
SELECT * FROM tenants;

selectTenantById:
SELECT * FROM tenants WHERE id = :id;

insertTenant:
INSERT INTO tenants (id, name, is_active)
VALUES (:id, :name, :isActive);

selectAllStores:
SELECT * FROM stores;

insertStore:
INSERT INTO stores (id, tenant_id, name, code)
VALUES (:id, :tenantId, :name, :code);

selectAllWarehouses:
SELECT * FROM warehouses;

insertWarehouse:
INSERT INTO warehouses (id, tenant_id, store_id, name, is_default)
VALUES (:id, :tenantId, :storeId, :name, :isDefault);

selectAllProducts:
SELECT * FROM products;

selectProductById:
SELECT * FROM products WHERE id = :id;

insertProduct:
INSERT INTO products (id, tenant_id, name, base_unit_id, has_variants, is_active)
VALUES (:id, :tenantId, :name, :baseUnitId, :hasVariants, :isActive);

selectAllStockItems:
SELECT * FROM stock_items;

selectInventoryBalance:
SELECT * FROM inventory_balances
WHERE warehouse_id = :warehouseId AND stock_item_id = :stockItemId;

insertInventoryBalance:
INSERT INTO inventory_balances (warehouse_id, stock_item_id, on_hand_ticks, reserved_ticks, current_moving_avg_cost)
VALUES (:warehouseId, :stockItemId, :onHandTicks, :reservedTicks, :currentMovingAvgCost);

selectAllSales:
SELECT * FROM sales;

selectSaleById:
SELECT * FROM sales WHERE id = :id;

selectAllUsers:
SELECT * FROM users;

selectUserByUsername:
SELECT * FROM users WHERE username = :username;


